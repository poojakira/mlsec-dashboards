# Copy to .env locally. Never commit the populated .env file.
# Generate your own secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=
DASHBOARD_ENV=development
DASHBOARD_RATE_LIMIT_RPM=180
# Required in production; set to your own read-only evidence directory.
DASHBOARD_EVIDENCE_ROOT=
# Empty in production means same-origin browser access only.
DASHBOARD_ALLOWED_ORIGINS=
